FROM python:3.12-slim

WORKDIR /app

COPY scripts/remote_sync_server.requirements.txt .
RUN pip install --no-cache-dir -r remote_sync_server.requirements.txt

COPY scripts/remote_sync_server.py .

# Render (and most PaaS hosts) inject $PORT; the server reads it at startup.
CMD ["python3", "remote_sync_server.py"]
